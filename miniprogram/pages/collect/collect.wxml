<!-- 收藏页(云函数收藏,支持删除) -->
<view class="page">
  <view class="hero" style="padding-top:{{safeTop + 16}}px">
    <image class="bi-icon" src="{{icons.HOT.starFilled}}" style="width:96rpx;height:96rpx" />
    <view class="hero-text">
      <text class="nav-title">我的收藏</text>
      <text class="nav-sub">共 {{collectList.length}} 条收藏</text>
    </view>
  </view>

  <view class="list-wrap" wx:if="{{loading}}">
    <view class="empty-tip">
      <view class="loading-dot" style="width:44rpx;height:44rpx;border:4rpx solid #000;border-top-color:#FF006E;animation:spin 0.8s linear infinite"></view>
      <view>加载中...</view>
    </view>
  </view>

  <view class="list-wrap" wx:elif="{{collectList.length>0}}">
    <view wx:for="{{collectList}}" wx:key="_id" class="collect-card" hover-class="press-fade" bindtap="goResult" data-name="{{item.name}}" data-item="{{item}}">
      <view class="card-icon" style="background:{{item.bgColor}}">
        <text class="card-emoji">{{item.itemEmoji || item.catEmoji}}</text>
      </view>
      <view class="card-main">
        <text class="card-name">{{item.name}}</text>
        <text class="card-tag" style="background:{{item.bgColor}};color:{{item.color}}">{{item.categoryName}}</text>
      </view>
      <view class="card-ops">
        <view class="del-btn" catchtap="deleteCollect" data-name="{{item.name}}" data-item="{{item}}">删除</view>
        <view class="arrow">></view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:else>
    <image class="bi-icon" src="{{icons.BLACK.star}}" style="width:80rpx;height:80rpx;opacity:0.35" />
    <view>暂无收藏内容</view>
  </view>
</view>
