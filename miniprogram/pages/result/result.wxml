<!-- 查询结果页(自定义返回按钮) -->
<view class="page">
  <!-- 自定义返回按钮 -->
  <view class="nav-back" style="top:{{safeTop + 8}}px" hover-class="press-fade" bindtap="goBack">
    <image class="bi-icon" src="{{icons.BLACK.arrowLeft}}" style="width:36rpx;height:36rpx" />
  </view>
  <view class="result-card" wx:if="{{trashInfo.name}}">
    <!-- 大色块分类头,延伸到状态栏 -->
    <view class="cat-header" style="background:{{trashInfo.bgColor}};padding-top:{{safeTop + 80}}px">
      <!-- AI 识别场景:显示用户拍的真实照片 -->
      <view class="cat-photo-wrap" wx:if="{{isAi && cameraFileID}}">
        <image class="cat-photo" src="{{cameraFileID}}" mode="aspectFill" />
        <view class="cat-photo-ring" style="border-color:{{trashInfo.color}}"></view>
      </view>
      <!-- 文字查询场景:保持分类 emoji 徽章 -->
      <view class="cat-icon-big" wx:else style="background:{{trashInfo.color}}">
        <text class="cat-big-emoji">{{trashInfo.catEmoji}}</text>
      </view>
      <text class="res-name">{{trashInfo.name}}</text>
      <text class="res-tag" style="background:{{trashInfo.color}};color:#fff">{{trashInfo.categoryName}}</text>
    </view>

    <!-- 内容区 -->
    <view class="res-body">
      <view class="res-block">
        <view class="block-title">
          <view class="block-dot" style="background:{{trashInfo.color}}"></view>
          <text>分类说明</text>
        </view>
        <text class="desc-text">{{trashInfo.desc || '暂无说明'}}</text>
      </view>

      <view class="res-block" wx:if="{{trashInfo.tip}}">
        <view class="block-title">
          <view class="block-dot" style="background:{{trashInfo.color}}"></view>
          <text>投放提示</text>
        </view>
        <text class="desc-text">{{trashInfo.tip}}</text>
      </view>

      <!-- AI 置信度 -->
      <view class="ai-card" wx:if="{{isAi}}">
        <view class="ai-row">
          <text class="ai-label">AI 识别置信度</text>
          <text class="ai-score">{{trashInfo.aiScore || 0}}%</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width:{{trashInfo.aiScore || 0}}%;background:{{trashInfo.color}}"></view>
        </view>
        <text class="ai-tip">AI 结果仅供参考,请以当地分类标准为准</text>
      </view>

      <view class="collect-btn {{isCollect?'active':''}}" hover-class="press-fade" bindtap="toggleCollect">
        {{isCollect?'已收藏':'加入收藏'}}
      </view>

      <!-- 分享海报 -->
      <view class="share-row">
        <button class="share-btn" open-type="share">分享给好友</button>
        <button class="share-btn poster" bindtap="generatePoster">生成海报</button>
      </view>
    </view>
  </view>

  <view class="loading-box" wx:elif="{{loading}}">
    <view class="loading-dot"></view>
    <text>查询中...</text>
  </view>
    <view class="empty-res" wx:else>
    <image class="bi-icon" src="{{icons.BLACK.search}}" style="width:80rpx;height:80rpx;opacity:0.35" />
    <view>未查询到该垃圾分类信息</view>
  </view>
</view>
