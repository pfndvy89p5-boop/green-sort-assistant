/* Neo-Brutalist 结果页 —— 严格对齐模板 page.tsx */
.page { padding: 0; background: #FFFFFF; }

/* 返回按钮 —— 小元素,--shadow-s = 12rpx */
.nav-back {
  position: fixed;
  left: 24rpx;
  width: 72rpx; height: 72rpx;
  background: #fff;
  border: 4rpx solid #000;
  box-shadow: 12rpx 12rpx 0 0 #000;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: box-shadow 150ms ease-out, transform 150ms ease-out;
}
.nav-back:active {
  box-shadow: none !important;
  transform: translate(12rpx, 12rpx) !important;
  background: #FF006E !important;
  transition: none;
}

.result-card { background: #fff; overflow: hidden; }

/* 分类头 —— 模板 Hero 装饰块风格:分类色背景 + 粗黑下边框 + 向上浮起 */
.cat-header {
  padding: 0 40rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  border-bottom: 4rpx solid #000;
}
/* 分类 icon 装饰块 —— 模板 Hero:border-4 + shadow-[8px_8px] */
.cat-icon-big {
  width: 140rpx; height: 140rpx;
  border: 4rpx solid #000;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 16rpx 16rpx 0 0 #000;
  /* 装饰微旋转,模板 rotate-3 */
  transform: rotate(-2deg);
}
.cat-big-emoji { font-size: 80rpx; }

/* AI 识别场景:用户真实照片徽章 */
.cat-photo-wrap {
  position: relative;
  width: 180rpx; height: 180rpx;
  border: 4rpx solid #000;
  border-radius: 0;
  box-shadow: 16rpx 16rpx 0 0 #000;
  transform: rotate(-2deg);
  overflow: visible;
  background: #fff;
}
.cat-photo {
  width: 100%; height: 100%;
  border-radius: 0;
  border: 4rpx solid #000;
  box-sizing: border-box;
}
.cat-photo-ring {
  position: absolute;
  top: -6rpx; left: -6rpx; right: -6rpx; bottom: -6rpx;
  border: 6rpx solid;
  border-radius: 0;
  pointer-events: none;
}
.res-name {
  font-size: 60rpx;
  font-weight: 900;
  color: #000;
  letter-spacing: 0;
  text-align: center;
  line-height: 1.05;
}
.res-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  border: 4rpx solid #000;
  font-size: 22rpx;
  font-weight: 900;
}

/* 内容区 */
.res-body { padding: 32rpx 32rpx 64rpx; }

/* 信息块 —— 模板 Feature 档,--shadow = 16rpx */
.res-block {
  margin-bottom: 24rpx;
  background: #fff;
  border: 4rpx solid #000;
  padding: 24rpx;
  box-shadow: 16rpx 16rpx 0 0 #000;
  transition: box-shadow 150ms ease-out, transform 150ms ease-out, background 150ms ease-out;
}
.res-block:active {
  box-shadow: none !important;
  transform: translate(16rpx, 16rpx) !important;
  background: #FF006E;
  transition: none;
}
.res-block:active .block-title text,
.res-block:active .desc-text {
  color: #fff;
}
.block-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
/* 模板里装饰元素:border-l-4 */
.block-dot {
  width: 12rpx; height: 12rpx;
  background: #FF006E;
}
.block-title text {
  font-size: 30rpx;
  font-weight: 900;
  color: #000;
}
.desc-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.7;
}

/* AI 卡 —— 模板 Stats 黑底白字风格,--shadow = 16rpx 粉红 */
.ai-card {
  background: #000;
  color: #fff;
  border: 4rpx solid #000;
  padding: 24rpx;
  margin: 32rpx 0;
  box-shadow: 16rpx 16rpx 0 0 #FF006E;
}
.ai-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.ai-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #CCFF00;
}
.ai-score {
  font-size: 36rpx;
  font-weight: 900;
  color: #CCFF00;
}
.progress-bar {
  height: 14rpx;
  background: #fff;
  border: 4rpx solid #fff;
}
.progress-fill { height: 100%; }
.ai-tip {
  display: block;
  font-size: 22rpx;
  font-weight: 500;
  color: #aaa;
  margin-top: 12rpx;
}

/* 收藏按钮 —— 大 CTA 档,--shadow-l = 24rpx,Physical Crushing 24rpx */
.collect-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FF006E;
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
  margin-top: 16rpx;
  border: 4rpx solid #000;
  box-shadow: 24rpx 24rpx 0 0 #000;
  text-align: center;
  transition: box-shadow 150ms ease-out, transform 150ms ease-out;
}
.collect-btn.active {
  background: #fff;
  color: #000;
  box-shadow: 12rpx 12rpx 0 0 #000;
}
.collect-btn:active {
  box-shadow: none !important;
  transform: translate(24rpx, 24rpx) !important;
  background: #000 !important;
  color: #fff !important;
  transition: none;
}

/* 分享按钮 */
.share-row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.share-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  background: #CCFF00;
  color: #000;
  font-size: 26rpx;
  font-weight: 900;
  border: 4rpx solid #000;
  box-shadow: 8rpx 8rpx 0 0 #000;
  border-radius: 0;
}
.share-btn::after { border: none; }
.share-btn.poster { background: #fff; }
.share-btn:active { box-shadow: none; transform: translate(8rpx, 8rpx); }

/* 加载/空 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #555;
  font-size: 28rpx;
  padding: 200rpx 0;
  font-weight: 500;
}
.loading-dot {
  width: 44rpx; height: 44rpx;
  border: 4rpx solid #000;
  border-top-color: #FF006E;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.empty-res {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #555;
  font-size: 28rpx;
  padding: 200rpx 0;
  font-weight: 500;
}
