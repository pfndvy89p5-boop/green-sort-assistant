<!-- Neo-Brutalist 自定义底部 Tab Bar —— 纯 SVG data URI 图标(绕过样式隔离) -->
<view class="tabbar">
  <view class="safe-area"></view>

  <view class="tabbar-inner">
    <view wx:for="{{list}}" wx:key="index"
          class="tab-item {{selected === index ? 'active' : ''}}"
          hover-class="press-fade"
          data-path="{{item.pagePath}}"
          data-index="{{index}}"
          bindtap="switchTab">
      <!-- SVG 图标:默认黑 / active 白 -->
      <view class="tab-icon-box">
        <image class="tab-icon" src="{{selected === index ? item.iconActive : item.icon}}" />
      </view>
      <text class="tab-text">{{ item.text }}</text>
    </view>
  </view>
</view>
